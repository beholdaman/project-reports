@using rapporti.Models.ViewModels
@{
    ViewData["Title"] = "Home Page";
}
@model ReportViewModel

<div class="text-center">
     @Html.Partial(partialViewName: "_Form")
    <table>
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Date</th>
                <th scope="col">Hour Start</th>
                <th scope="col">Hour End</th>
                <th scope="col">User Id</th>
                <th scope="col">Project Id</th>
            </tr>
        </thead>

        <tbody>
            @foreach(var item in Model.ReportList)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Date</td>
                    <td>@item.HourStart</td>
                    <td>@item.HourEnd</td>
                    <td>@item.UserModel</td>
                    <td>@item.ProjectModel</td>
                    <td class="button-column">
                        <input type="submit" value="Delete" onClick="deleteReport(@item.Id)"/>
                    </td>
                </tr>

            }
        </tbody>
    </table>
</div>
